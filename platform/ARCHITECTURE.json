{
  "version": 1,
  "nouns": [
    "jobs",
    "resources",
    "actors",
    "environments"
  ],
  "allowedDependencies": {
    "jobs": [
      "resources"
    ],
    "resources": [],
    "actors": [
      "environments",
      "jobs",
      "resources"
    ],
    "environments": [
      "resources",
      "jobs"
    ]
  },
  "layers": {
    "platform": {
      "path": "platform",
      "mayDependOn": [
        "platform"
      ]
    },
    "jobs": {
      "path": "jobs",
      "mayDependOn": [
        "platform",
        "jobs"
      ]
    },
    "experiences": {
      "path": "experiences",
      "mayDependOn": [
        "platform",
        "jobs"
      ]
    },
    "infra": {
      "path": "infra",
      "mayDependOn": [
        "platform"
      ]
    },
    "host": {
      "path": "host",
      "mayDependOn": [
        "platform",
        "jobs",
        "experiences",
        "infra",
        "host"
      ]
    }
  },
  "externalDependencies": {
    "platform": [],
    "jobs": [],
    "experiences": [],
    "infra": [
      "@earendil-works/pi-ai",
      "@earendil-works/pi-ai/api/openai-codex-responses.lazy",
      "@earendil-works/pi-ai/providers/openai-codex.models",
      "@flue/runtime",
      "@flue/runtime/node",
      "@flue/runtime/routing",
      "@hono/node-server",
      "hono",
      "node:crypto",
      "node:fs",
      "node:os",
      "node:path",
      "valibot"
    ],
    "host": [
      "@earendil-works/pi-ai",
      "@flue/runtime",
      "@flue/runtime/node",
      "@flue/runtime/routing",
      "@hono/node-server",
      "hono",
      "hono/compress",
      "node:fs",
      "node:os",
      "node:path",
      "node:sqlite",
      "node:url"
    ]
