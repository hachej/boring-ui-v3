      "description": "@boring/chat's BoringChat, headless, dressed with shadcn primitives through its slots: messages, tool calls with outcomes, ask and approval cards, run status and a composer.",
      "dependencies": [
        "@boring/chat",
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "textarea",
        "https://hachej.github.io/boring-ui-v3/r/chat-message.json",
