{
  "name": "boring",
  "private": true,
  "type": "module",
  "description": "Boring: a library for putting an agent next to an application. Three packages: files, agent, chat.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "node bin/boring.mjs check",
    "verify": "node bin/boring.mjs verify all",
    "typecheck": "tsc -p tsconfig.json",
    "test:architecture": "node --test test/architecture/*.test.mjs",
    "test:formal": "node --test test/formal/*.test.mjs",
    "setup:formal": "node tools/setup-formal.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "1.57.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^6.4.3"
  }
}
